# EmailJS — contact form (dashboard.emailjs.com)
# Public por diseño (se exponen en el cliente).
NUXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
NUXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NUXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id

# Careers — Nuro Platform API (server-side only; never exposed to the browser)
NUXT_PLATFORM_API_URL=http://localhost:8080
# Same value as WEBSITE_API_KEY in Nuro Platform. openssl rand -hex 32
NUXT_PLATFORM_API_KEY=
# Cloudflare Turnstile site key. Local dev always-pass test key:
# 1x00000000000000000000AA
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
